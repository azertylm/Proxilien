# GEMINI_API_KEY: Requis pour Phase 1 (Prototypage & Validation Google Gemini).
# AI Studio injecte automatiquement cette clé lors de l'exécution.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MISTRAL_API_KEY: Requis pour Phase 3 (Secours Cloud Européen Souverain Mistral AI - France/Europe).
MISTRAL_API_KEY=""

# LOCAL_AI_URL: Phase 2 - Machine locale haute performance dédiée (Ollama / vLLM).
# Coût d'inférence nul, données strictement souveraines.
LOCAL_AI_URL="http://localhost:11434"

# LOCAL_AI_MODEL: Nom du modèle open-source exécuté en local.
LOCAL_AI_MODEL="mistral-nemo"

# MISTRAL_MODEL: Nom du modèle de repli souverain Mistral AI Cloud.
MISTRAL_MODEL="mistral-small-latest"

# AI_PROVIDER: Mode d'exécution de la couche d'abstraction :
# 'gemini' (Phase 1 active) | 'hybrid_mistral' (Phase 2 locale + Phase 3 secours) | 'mistral_cloud' | 'local_only'
AI_PROVIDER="gemini"

# TIMEOUT_LOCAL_MS: Délai maximal d'attente avant basculement transparent vers le secours européen (en ms).
TIMEOUT_LOCAL_MS="3500"

# APP_URL: URL où l'application est hébergée (Cloud Run ou serveurs souverains OVH alphabette.fr).
APP_URL="MY_APP_URL"
